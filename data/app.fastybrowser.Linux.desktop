[Desktop Entry]
Type=Application
Name=Fasty
GenericName=Web Browser
Comment=A small, fast, quiet web browser
Exec=fasty-browser %U
Icon=fasty-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=app.fastybrowser.Linux
Keywords=web;browser;internet;webkit;
Actions=new-private-tab;

[Desktop Action new-private-tab]
Name=New Private Tab
Exec=fasty-browser --private
